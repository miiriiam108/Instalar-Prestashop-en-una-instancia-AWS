# ---- General ----
DOMAIN=tu-dominio.ddns.net
LE_EMAIL=tu-correo@ejemplo.com

# ---- PHP (php.ini) ----
PHP_MEMORY_LIMIT=256M
PHP_MAX_INPUT_VARS=5000
PHP_POST_MAX_SIZE=128M
PHP_UPLOAD_MAX_FILESIZE=128M

# ---- Base de datos ----
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_NAME=prestashop
DB_USER=ps_user
DB_PASSWORD=cambia_esta_clave_db

# ---- PrestaShop ----
# Comprueba la ultima version en https://github.com/PrestaShop/PrestaShop/tags
PS_VERSION=9.2.0
PS_LANGUAGE=es
PS_COUNTRY=es
PS_ADMIN_EMAIL=admin@ejemplo.com
PS_ADMIN_PASSWORD=cambia_esta_clave_admin
PS_DB_PREFIX=ps_

# ---- phpMyAdmin ----
PMA_APP_PASSWORD=cambia_esta_clave_pma

# ---- PhpPsInfo ----
PHPPSINFO_URL=https://raw.githubusercontent.com/PrestaShop/php-ps-info/master/phppsinfo.php
