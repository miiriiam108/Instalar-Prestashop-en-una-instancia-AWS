# ---- General ----
# IP de la máquina virtual (comprueba con: ip a). Si usas NAT con redirección de puertos, pon localhost:PUERTO
DOMAIN=192.168.1.11
# 0 = HTTP (sin certificado). Pon 1 solo si configuras HTTPS con el script opcional
PS_SSL=0

# ---- PHP (php.ini) ----
PHP_MEMORY_LIMIT=256M
PHP_MAX_INPUT_VARS=5000
PHP_POST_MAX_SIZE=128M
PHP_UPLOAD_MAX_FILESIZE=128M

# ---- Base de datos ----
DB_ROOT_PASSWORD=8888
DB_NAME=prestashop
DB_USER=ps_user
DB_PASSWORD=8888

# ---- PrestaShop ----
# Comprueba la ultima version en https://github.com/PrestaShop/PrestaShop/tags
PS_VERSION=9.2.1
PS_LANGUAGE=es
PS_COUNTRY=es
PS_ADMIN_EMAIL=mporrom02@iesalbarregas.es
PS_ADMIN_PASSWORD=8888
PS_DB_PREFIX=ps_

# ---- phpMyAdmin ----
PMA_APP_PASSWORD=8888

# ---- PhpPsInfo ----
PHPPSINFO_URL=https://raw.githubusercontent.com/PrestaShop/php-ps-info/master/phppsinfo.php
